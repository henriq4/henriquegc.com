---
import Layout from "@layouts/Layout.astro";
import Socials from "@components/Socials.astro";
import { ABOUT } from "@consts";

const experience = [
  { name: "Bitzen Tecnologia", role: "software engineer", years: "2024–now" },
  { name: "São Paulo Mais Perto", role: "project lead", years: "2022–now" },
  { name: "SetupJr", role: "CTO", years: "2022–2024" },
  { name: "Star Formação", role: "web developer", years: "2021–2022" },
];
---

<Layout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <img src="/brand/me.jpg" alt="Henrique GC" class="portrait" width="96" height="96" />
  <h1>Hi, I'm <span class="marker">Henrique</span>.</h1>
  <p>
    I'm a backend software engineer in Brazil. I've worked as an engineer, a project lead and a CTO, and I like the
    part of the job where architecture and people meet.
  </p>
  <p>
    I work mostly in Java and Spring, and also Node.js, NestJS, Laravel, React and Flutter. I speak English
    professionally and Portuguese natively.
  </p>

  <section>
    <h2 class="label">Experience</h2>
    <ul class="list">
      {
        experience.map((x) => (
          <li>
            <span>
              <strong>{x.name}</strong>
              <span class="muted"> · {x.role}</span>
            </span>
            <span class="right">{x.years}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <Socials />
  </section>
</Layout>
