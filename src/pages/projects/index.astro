---
import Layout from "@layouts/Layout.astro";
import EntryList from "@components/EntryList.astro";
import { PROJECTS } from "@consts";
import { byDate } from "@lib/utils";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", (e) => !e.data.draft)).sort(byDate);
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <h1>Things I've <span class="marker">built and led</span>.</h1>
  <section>
    <h2 class="label">Work</h2>
    <EntryList entries={projects} />
  </section>
</Layout>
