---
import Layout from "@layouts/Layout.astro";
import EntryList from "@components/EntryList.astro";
import Socials from "@components/Socials.astro";
import { HOME } from "@consts";
import { byDate } from "@lib/utils";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", (e) => !e.data.draft)).sort(byDate);
const posts = (await getCollection("blog", (e) => !e.data.draft)).sort(byDate);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <h1>
    I build backends and <span class="marker">lead the teams</span> behind them.
  </h1>
  <p>Java and Spring, mostly. Engineer, project lead and CTO so far. Based in Brazil, open to remote roles.</p>
  <Socials />

  <section>
    <h2 class="label">Work</h2>
    <EntryList entries={projects} />
  </section>

  <section>
    <h2 class="label">Writing</h2>
    <EntryList entries={posts} />
  </section>
</Layout>
